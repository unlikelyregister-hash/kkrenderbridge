      {
        "type": "click",
        "x": 546,
        "y": 665,
        "button": "left",
        "description": "Click 'Char Maker' on title screen (point_1: char maker)"
      },
      {
        "type": "delay",
        "ms": 2000,
        "description": "Wait for sub-menu"
      },
      {
        "type": "click",
        "x": 291,
        "y": 671,
        "button": "left",
        "description": "Click 'Female' on gender selection (point_2: female)"
      },
      {
        "type": "delay",
        "ms": 8000,
        "description": "Wait for CM to load"
      }
    ]
  },
  "load_character": {
